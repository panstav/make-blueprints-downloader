# Make.com API Token (Create this in your Make.com Profile > API tab)
MAKE_API_TOKEN=your_api_token_here

# Make.com Environment/Zone URL (Check your address bar when logged in)
# Examples: https://eu1.make.com, https://us1.make.com
MAKE_ZONE_URL=https://eu1.make.com

# Make.com Organization ID (Get this from your organization dashboard URL)
MAKE_ORGANIZATION_ID=your_organization_id_here
